{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reelforge",
  "version": "0.1.0",
  "identifier": "dev.reelforge.app",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Reelforge",
        "width": 1600,
        "height": 950,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": true,
        "backgroundColor": "#1b1c1f"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
